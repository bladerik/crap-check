{
	"name": "@bladerik/crap-check",
	"version": "0.1.0",
	"description": "CRAP score gate for the functions a change touches in JavaScript and TypeScript projects.",
	"type": "module",
	"license": "MIT",
	"bin": {
		"crap-check": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"crap": "node dist/cli.js"
	},
	"dependencies": {
		"picomatch": "^4.0.2",
		"typescript": "^5.6.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"@types/picomatch": "^3.0.1",
		"@vitest/coverage-v8": "^3.2.4",
		"vitest": "^3.2.4"
	}
}
