{
	"name": "@bladesk/crap-check",
	"version": "0.1.0",
	"description": "CRAP score gate for the functions a change touches in JavaScript and TypeScript projects.",
	"type": "module",
	"license": "MIT",
	"author": "Lukáš (https://github.com/bladerik)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bladerik/crap-check.git"
	},
	"homepage": "https://github.com/bladerik/crap-check#readme",
	"bugs": {
		"url": "https://github.com/bladerik/crap-check/issues"
	},
	"keywords": [
		"crap",
		"cyclomatic-complexity",
		"coverage",
		"code-quality",
		"pre-push",
		"typescript",
		"javascript",
		"vitest",
		"jest"
	],
	"bin": {
		"crap-check": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"crap": "node dist/cli.js"
	},
	"dependencies": {
		"picomatch": "^4.0.2",
		"typescript": "^5.6.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"@types/picomatch": "^3.0.1",
		"@vitest/coverage-v8": "^3.2.4",
		"vitest": "^3.2.4"
	},
	"packageManager": "pnpm@11.22.0"
}
